# Discord Developer Portal の Bot トークン（絶対に公開しない）
DISCORD_TOKEN=
# ボットを入れたDiscordサーバーのID
GUILD_ID=
# /cmd を使える人のDiscordユーザーID（カンマ区切り）。空なら誰も使えない
ADMIN_IDS=

# systemd のサービス名
MC_SERVICE=minecraft
# /start や /status で表示する接続先（任意）
SERVER_ADDRESS=
SERVER_PORT=19132

# server.properties の rcon.port / rcon.password と同じ値
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# 温度警告を送るチャンネルID（空なら警告しない）
ALERT_CHANNEL_ID=
TEMP_WARN=75
# この温度以上が3回続いたら（30秒ごとに確認＝約90秒）マイクラサーバーを自動停止する。0 で無効
TEMP_SHUTDOWN=85

# マイクラの server.properties の場所（空なら ~/minecraft/server.properties）
SERVER_PROPERTIES=
# 管理パネルを置くチャンネルID。設定すると、そこに誰かが投稿したときパネルを一番下に送り直す（空なら送り直さない）
PANEL_CHANNEL_ID=

# --- ユーザー登録（Discord のメンバーが自分でホワイトリストに登録する機能） ---
# ユーザー登録パネルを置くチャンネルID（空なら無効。PANEL_CHANNEL_ID とは別のチャンネルにすること）
REGISTER_CHANNEL_ID=
# マイクラサーバーのフォルダ（空なら ~/minecraft）。whitelist.json と logs/latest.log はここから探す
MC_DIR=
# 個別に指定したいときだけ（空なら MC_DIR 配下）
WHITELIST_FILE=
MC_LOG_FILE=
# Server Members Intent を Developer Portal で ON にしたら 1（既定）。OFF のままなら 0（退出メンバーの自動削除が効かなくなる）
MEMBERS_INTENT=1
