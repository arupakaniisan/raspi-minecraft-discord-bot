# Discord Developer Portal の Bot トークン（絶対に公開しない）
DISCORD_TOKEN=
# ボットを入れたDiscordサーバーのID
GUILD_ID=
# /stop と /cmd を使える人のDiscordユーザーID（カンマ区切り）。空なら /stop は全員、/cmd は誰も使えない
ADMIN_IDS=

# systemd のサービス名
MC_SERVICE=minecraft
# /start や /status で表示する接続先（任意）
SERVER_ADDRESS=
SERVER_PORT=19132

# server.properties の rcon.port / rcon.password と同じ値
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# 温度警告を送るチャンネルID（空なら警告しない）
ALERT_CHANNEL_ID=
TEMP_WARN=75
